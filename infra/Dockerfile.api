# ==========================================
# UNTANGLE API & Perception Service Dockerfile
# Python 3.11 slim with OpenCV, Tesseract OCR
# ==========================================

FROM python:3.11-slim as base

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    DEBIAN_FRONTEND=noninteractive

WORKDIR /app

# System dependencies for PyMuPDF, OpenCV, and Tesseract OCR
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    curl \
    git \
    libgl1 \
    libglib2.0-0 \
    tesseract-ocr \
    tesseract-ocr-eng \
    libtesseract-dev \
    libleptonica-dev \
    && rm -rf /var/lib/apt/lists/*

# Non-root user setup
RUN useradd -m -u 1000 appuser && \
    mkdir -p /app/data/jobs && \
    chown -R appuser:appuser /app

# Install Python requirements
COPY services/perception/requirements.txt /app/services/perception/requirements.txt
RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir -r /app/services/perception/requirements.txt

# Copy source trees
COPY contracts /app/contracts
COPY services /app/services
COPY docs /app/docs
COPY pyproject.toml /app/pyproject.toml

USER appuser

EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=5s --start-period=5s --retries=3 \
    CMD curl -f http://localhost:8000/api/v1/health || exit 1

CMD ["python", "-m", "uvicorn", "services.api.app.main:app", "--host", "0.0.0.0", "--port", "8000"]
