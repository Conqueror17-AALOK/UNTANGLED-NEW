# ==========================================
# UNTANGLE Monorepo .gitignore
# ==========================================

# OS & IDE
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo

# Environment & Secrets (NEVER COMMIT)
.env
.env.local
.env.*.local
*.key
*.pem
scripts/
!infra/scripts/

# Python artifacts
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
ENV/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Testing & Typechecking
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.nox/
.tox/

# Node & Frontend
node_modules/
.pnp
.pnp.js
apps/web/dist/
apps/web/.next/
apps/web/build/
.vite/
apps/web/.vite/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.eslintcache

# Runtime Job & Cache Storage (Local)
data/*
!data/.gitkeep
!data/README.md
*.sqlite
*.sqlite3
*.db

# Temporary artifacts & debug overlays
tmp/
temp/
debug_output/
*.out

# YOLO Training Runs & Base Weights
runs/
yolo11*.pt
!models/yolo11_pid.pt

# Florence-2 Large Model Weights & Checkpoints (Local)
models/florence2*/*.safetensors
models/florence2*/*.bin
data/florence_dataset/
extra datasets/
new dataset/
*.zip
