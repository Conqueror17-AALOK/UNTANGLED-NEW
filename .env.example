# ============================================================
# UNTANGLE Environment Variables Configuration
# Copy this file to .env before starting the services
# ============================================================

# Security & Authentication (optional bearer token for deployed demo)
# If left empty in local dev, auth checks are skipped
API_TOKEN=

# Database configuration (SQLite default, Postgres compatible)
DATABASE_URL=sqlite:///./data/untangle.db

# File storage location for uploaded PDFs, crops, and job artifacts
DATA_DIR=./data/jobs

# LLM Provider configuration ('nvidia')
LLM_PROVIDER=nvidia

# NVIDIA API keys (GLM 5.3 Flash & DeepSeek V4.1 Flash)
NVIDIA_API_KEY_GLM=
NVIDIA_API_KEY_DEEPSEEK=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# LLM model selection (fast bulk vs strong escalation)
LLM_MODEL_FAST=z-ai/glm-5.3-flash
LLM_MODEL_STRONG=deepseek-ai/deepseek-v4.1-flash

# Confidence thresholds for multi-signal decision logic
# Above CONF_AUTO_THRESHOLD -> auto-accepted (green)
# Between CONF_REVIEW_THRESHOLD and CONF_AUTO_THRESHOLD -> LLM resolve (amber)
# Below CONF_REVIEW_THRESHOLD -> human review queue (red)
CONF_AUTO_THRESHOLD=0.85
CONF_REVIEW_THRESHOLD=0.60

# CORS settings for FastAPI backend (comma-separated origins)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:5173

# Frontend build-time & runtime environment variables
VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_USE_MOCKS=false
VITE_API_TOKEN=
