{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ResolvedItemsOutput",
  "type": "object",
  "required": ["job_id", "items"],
  "properties": {
    "job_id": { "type": "string" },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "page", "raw_text", "normalized_tag", "type", "category", "bbox", "confidence", "conf_breakdown", "status", "io_match"],
        "properties": {
          "id": { "type": "string" },
          "page": { "type": "integer" },
          "raw_text": { "type": "string" },
          "normalized_tag": { "type": "string" },
          "type": { "type": "string" },
          "category": { "type": "string", "enum": ["instrument", "equipment", "valve", "line"] },
          "bbox": {
            "type": "array",
            "items": { "type": "number" },
            "minItems": 4,
            "maxItems": 4
          },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
          "conf_breakdown": {
            "type": "object",
            "properties": {
              "ocr": { "type": "number" },
              "symbol": { "type": "number" },
              "io_match": { "type": "number" },
              "grammar": { "type": "number" },
              "llm": { "type": "number" }
            }
          },
          "status": { "type": "string", "enum": ["resolved", "needs_review", "rejected"] },
          "io_match": {
            "type": "object",
            "properties": {
              "matched": { "type": "boolean" },
              "io_tag": { "type": "string" },
              "score": { "type": "number" }
            }
          },
          "reasoning": { "type": "string" }
        }
      }
    }
  }
}
